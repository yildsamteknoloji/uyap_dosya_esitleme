{
  "manifest_version": 3,
  "name": "UYAP Dosya Eşitleyici",
  "version": "2.3.1",
  "description": "UYAP Vatandaş Portal dosya listesine 'Eşitle' düğmesi ekler; dosyanın evraklarını seçtiğiniz klasöre (Daire_Esas alt klasörü) doğrudan yazar, klasörde olanları atlar. Tarayıcı indirme penceresi açılmaz.",
  "key": "",
  "permissions": [
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://vatandas.uyap.gov.tr/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "UYAP Dosya Eşitleyici",
    "default_popup": "options.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://vatandas.uyap.gov.tr/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://vatandas.uyap.gov.tr/*"
      ],
      "js": [
        "page.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}